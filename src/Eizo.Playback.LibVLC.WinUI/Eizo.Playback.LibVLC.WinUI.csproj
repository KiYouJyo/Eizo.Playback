<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Eizo.Playback.LibVLC.WinUI</AssemblyName>
    <RootNamespace>Eizo.Playback.WinUI</RootNamespace>
    <Description>WinUI 3 video-surface integration for Eizo.Playback's LibVLC backend.</Description>
    <!-- This package contains no authored WinUI resources. NuGet's SDK pack defaults
         include .pri outputs, so exclude them explicitly to avoid polluting consuming
         applications' MRT resource graphs. -->
    <DefaultAllowedOutputExtensionsInPackageBuildOutputFolder>.dll;.exe;.winmd;.json;.xml</DefaultAllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Eizo.Playback.Abstractions/Eizo.Playback.Abstractions.csproj" />
    <ProjectReference Include="../Eizo.Playback.LibVLC/Eizo.Playback.LibVLC.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="SharpDX.Direct3D11" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
